{
  "name": "aura-research",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "participant:issue": "node --env-file=.env.local scripts/issue-participant.mjs",
    "participant:confirm": "node --env-file=.env.local scripts/confirm-paper-consent.mjs",
    "consent:publish": "node --env-file=.env.local scripts/publish-consent-documents.mjs",
    "consent:test": "node --env-file=.env.local scripts/verify-online-consent.mjs",
    "pilot:report": "node --import tsx --env-file=.env.local scripts/pilot-report.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
