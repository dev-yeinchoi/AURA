# AURA 환경변수 (실제 값은 .env.local 에 둔다 — 커밋하지 않는다)
#
# 로컬: pnpm supabase start 출력의 API URL 과 secret key 를 넣는다.
# NEXT_PUBLIC_ 접두사 변수는 두지 않는다 (계획 D2).

# Supabase (서버 전용)
SUPABASE_URL=
# secret key 만 사용한다 (sb_secret_… ). 레거시 anon/service_role 키는 쓰지 않는다.
SUPABASE_SECRET_KEY=

# 연구자 시작 화면 패스코드 (계획 D4 — 플레이스홀더)
RESEARCHER_PASSCODE=

# participant_id 세션 쿠키 서명 키 (계획 D3). 32바이트 이상 무작위 문자열
SESSION_SECRET=
